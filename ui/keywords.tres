[gd_resource type="Resource" script_class="KeywordTable" load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/keyword_table.gd" id="1_keyword_table"]

[resource]
script = ExtResource("1_keyword_table")
entries = Dictionary[String, String]({
"Toll": "Gained when you lose HP to your own effects. Up to {carry} carries over after a fight.",
"Grace": "After enemy hits get through your Block, damage you deal on your next turn wins HP back, up to the largest hit.",
"Critical": "At or below {threshold}% of your max HP.",
"Drain": "Heal for the HP the damage takes from enemies, up to the Drain's number if it has one.",
"Spent": "Removed for the rest of this fight once played.",
"Attack": "A card marked STRIKE, or an enemy's damaging move. Some effects only apply to Attacks."
})
