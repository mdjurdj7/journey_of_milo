#!/bin/sh
# Every new script/shader must come with its Godot .uid sidecar - staged
# in the same commit or already tracked. Otherwise a teammate's editor
# makes its own, and the later .uid commit blocks their pull.
# Generate: the Godot 4.7.1 main executable (not the _console wrapper)
# with --headless --path . --import
# Enable once per machine: git config core.hooksPath .githooks

missing=""
files=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACR -- '*.gd' '*.gdshader' '*.gdshaderinc')
while IFS= read -r f; do
	[ -z "$f" ] && continue
	# Godot skips folders under a .gdignore (reference/): no .uid there.
	dir=$(dirname "$f")
	skip=""
	while [ "$dir" != "." ]; do
		if git cat-file -e ":$dir/.gdignore" 2>/dev/null; then
			skip=1
			break
		fi
		dir=$(dirname "$dir")
	done
	[ -n "$skip" ] && continue
	# In the index = staged now or already tracked (a staged delete fails).
	if ! git cat-file -e ":$f.uid" 2>/dev/null; then
		missing="$missing
  $f.uid"
	fi
done <<EOF
$files
EOF

if [ -n "$missing" ]; then
	echo "pre-commit: missing .uid for new script/shader:$missing"
	echo "Run the Godot 4.7.1 main executable with --headless --path . --import,"
	echo "then stage each .uid by path in this same commit."
	exit 1
fi

# Card art imports Lossless, with no size limit and mipmaps on - the
# addons/card_art_import plugin sets that in the editor; this catches a
# card image's .import staged without it (an editor without the plugin,
# or one that rewrote the file with defaults).
wrong=""
imports=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR -- 'cards/art/*.import')
while IFS= read -r f; do
	[ -z "$f" ] && continue
	staged=$(git show ":$f" 2>/dev/null)
	ok=1
	for want in 'compress/mode=0' 'process/size_limit=0' 'mipmaps/generate=true'; do
		echo "$staged" | grep -qx "$want" || ok=""
	done
	if [ -z "$ok" ]; then
		wrong="$wrong
  $f"
	fi
done <<EOF
$imports
EOF

if [ -n "$wrong" ]; then
	echo "pre-commit: card art not imported Lossless, size limit 0, mipmaps on:$wrong"
	echo "Set those in the Import dock (or let the Card Art Import plugin do it), reimport, and stage again."
	exit 1
fi
exit 0
