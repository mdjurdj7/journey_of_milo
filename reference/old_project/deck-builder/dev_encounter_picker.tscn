[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://dev_encounter_picker.gd" id="1_picker"]

[node name="DevEncounterPicker" type="Node2D"]
script = ExtResource("1_picker")

[node name="UI" type="CanvasLayer" parent="."]

[node name="Background" type="ColorRect" parent="UI"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.08, 0.08, 0.1, 1)

[node name="Margin" type="MarginContainer" parent="UI"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 30
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 30

[node name="Root" type="VBoxContainer" parent="UI/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="HeaderRow" type="HBoxContainer" parent="UI/Margin/Root"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="UI/Margin/Root/HeaderRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.870588, 0.839216, 0.784314, 1)
theme_override_font_sizes/font_size = 28
text = "Dev: Encounter Picker"

[node name="BackButton" type="Button" parent="UI/Margin/Root/HeaderRow"]
layout_mode = 2
text = "Back"

[node name="ClassRow" type="HBoxContainer" parent="UI/Margin/Root"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="ClassLabel" type="Label" parent="UI/Margin/Root/ClassRow"]
