[node name="AuthoredPanel" type="VBoxContainer" parent="UI/Margin/Root"]
layout_mode = 2
size_flags_vertical = 3

[node name="AuthoredScroll" type="ScrollContainer" parent="UI/Margin/Root/AuthoredPanel"]
