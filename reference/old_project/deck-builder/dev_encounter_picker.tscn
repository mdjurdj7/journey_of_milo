theme_override_colors/font_color = Color(0.870588, 0.839216, 0.784314, 1)
text = "Class:"

[node name="ClassWandererButton" type="Button" parent="UI/Margin/Root/ClassRow"]
layout_mode = 2
toggle_mode = true
button_pressed = true
text = "Wanderer"

[node name="ClassSamuraiButton" type="Button" parent="UI/Margin/Root/ClassRow"]
layout_mode = 2
toggle_mode = true
text = "Samurai"

[node name="ClassNoteLabel" type="Label" parent="UI/Margin/Root/ClassRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.48, 0.45, 1)
