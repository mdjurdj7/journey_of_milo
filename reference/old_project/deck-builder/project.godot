; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Deck Builder"
run/main_scene="res://title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

RunState="*res://run_state.tscn"
SceneTransition="*res://scene_transition.tscn"
RoomState="*res://room_state.tscn"
AudioManager="*res://audio_manager.tscn"
MusicManager="*res://music_manager.tscn"
OverlayStyle="*res://overlay_style.tscn"
RunLogger="*res://run_logger.tscn"
SunkenWorksPalette="*res://sunken_works_palette.tscn"
HudPalette="*res://hud_palette.tscn"
CardUpgradeService="*res://card_upgrade_service.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
