[ext_resource type="Script" path="res://cards/card_effect.gd" id="2_card_effect"]
[ext_resource type="Resource" path="res://battle/rules/statuses/refuse_the_end.tres" id="3_refuse_the_end"]

[sub_resource type="Resource" id="CardEffect_apply_status"]
script = ExtResource("2_card_effect")
