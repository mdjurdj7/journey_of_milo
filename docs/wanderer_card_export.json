      },
      {
        "name": "Critical",
        "rule": "HP at or below 30% of max HP (CharacterData.critical_hp_fraction). Checked live when an effect resolves."
      },
      {
        "name": "Block",
        "rule": "Absorbs damage before HP; resets at the start of your turn. Last Resort prevents gaining it."
      },
      {
        "name": "Self-damage",
        "rule": "Bypasses block and absorb, makes Toll, opens no Grace, can kill (Down Payment's never takes you below 1)."
      },
      {
        "name": "Stance",
        "rule": "One stance type at a time, for the rest of the fight. Another copy of the held stance adds a stack; a different stance replaces it at 1. Played stance cards leave the deck's rotation for the fight."
      },
      {
        "name": "Power",
        "rule": "Applies a lasting status for the fight; coexists with the stance and other powers. Played power cards leave the deck's rotation for the fight."
      },
      {
        "name": "Attack bonus",
        "rule": "Flat extra damage from the stance (x stacks) and Dying Light, paid once per Attack card on its first damage effect - Reckoning included."
      },
      {
        "name": "Braced (enemy)",
        "rule": "Brace's debuff: the enemy's next attack deals 50% less, every hit halved; gone once that attack resolves, even fully blocked."
      }
    ]
