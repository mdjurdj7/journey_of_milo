[resource]
script = ExtResource("1_enemy_data")
enemy_name = "Adder"
mechanic_summary = "An elite dune adder, coiled on the faint side of floor 4's dune loop: Coil, Bite 6 and 3 Venom, Strike 11, in a loop. Coiled from its Coil until its next move (a Denied Coil brings none), it strikes back for 5 at every Attack played against it; Venom takes its stacks in HP at the start of each turn, past Block, then falls by 1. Teaches holding Attacks for the right turn, and pays a keepsake and Glassbone for it."
max_hp = 60
intents = Array[ExtResource("2_intent")]([SubResource("EnemyIntent_coil"), SubResource("EnemyIntent_bite"), SubResource("EnemyIntent_strike")])
; Placeholder: the Stork's body hits, until an adder sound exists.
contact_sounds = Array[AudioStream]([ExtResource("5_hit_1"), ExtResource("6_hit_2")])
is_elite = true
defeat_line = "The adder is still."
keepsake_table = ExtResource("7_keepsakes")
glassbone_reward = 1
model_scene_path = "res://assets/models/enemies/Adder/Adder.glb"
model_scale = 0.75
model_yaw_offset_degrees = 180.0
