[resource]
script = ExtResource("1_enemy_data")
enemy_name = "Nettle"
mechanic_summary = "One of the three small scorpions riding in the Nettlebasket's cradle. Not in the fight until she Signals - no plate, no intent, out of reach of every card, Carve included - then it comes off the basket to its place, Nips for 2 every turn, and answers each Signal with one more Nip out of turn. If she falls before her Signal, it never comes out."
max_hp = 9
intents = Array[ExtResource("2_intent")]([SubResource("EnemyIntent_nip")])
starts_dormant = true
starts_aboard = true
contact_sounds = Array[AudioStream]([ExtResource("3_hit_shell"), ExtResource("4_hit_shell_2"), ExtResource("5_hit_shell_3")])
model_scene_path = "res://assets/models/enemies/Nettlebasket/Nettlebasket.glb"
attachment_scene_path = "res://field/nettlebasket_pose.tscn"
model_scale = 0.12
painted_albedo_path = "res://assets/models/enemies/Nettlebasket/Nettlebasket_0.jpg"
contact_radius_m = 0.6
cluster_gap_m = 1.0
