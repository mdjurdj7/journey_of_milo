[resource]
script = ExtResource("1_enemy_data")
enemy_name = "Siltjaw"
contact_sounds = Array[AudioStream]([ExtResource("6_hit_shell"), ExtResource("7_hit_shell_2"), ExtResource("8_hit_shell_3")])
armored_contact_sounds = Array[AudioStream]([ExtResource("9_hit_armor")])
mechanic_summary = "Buried in the sand on the field, and dug in when the fight opens: three mounds of 12 HP rise close together and it is under one of them. Break its mound and it surfaces Exposed (takes 50% more) until your next turn ends, the overkill carried into it; break a wrong one and nothing happens. An attack on every enemy hits every mound. Left alone through your turn, it Erupts for 14 - only Block reduces it, not Brace, Garnish, No Further or Unbroken - and surfaces. Up, it Snaps for 6, Charges for 14, then Digs again. Teaches reading the sand - the one mound that breathes."
max_hp = 44
intents = Array[ExtResource("2_intent")]([SubResource("EnemyIntent_snap"), SubResource("EnemyIntent_charge"), SubResource("EnemyIntent_dig")])
opens_dug_in = true
model_scene_path = "res://assets/models/enemies/Siltjaw/Siltjaw.glb"
model_scale = 1.3356
attachment_scene_path = "res://field/rear_pose.tscn"
painted_albedo_path = "res://assets/models/enemies/Siltjaw/Siltjaw_Image_0.jpg"
rest_height_m = -0.66
battle_hover_m = -0.08
contact_radius_m = 1.0
