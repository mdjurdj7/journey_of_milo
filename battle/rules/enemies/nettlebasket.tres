[resource]
script = ExtResource("1_enemy_data")
enemy_name = "Nettlebasket"
mechanic_summary = "A scorpion carrying three Nettles in the cradle on her back. Pinches for 6, then Signals - every Nettle comes off the basket and strikes at once, out of turn - then Stings for 12, in a loop; with the Nettles gone the Signal drops out and she alternates Pinch and Sting. Until the Signal the fight is her alone: the Nettles can't be hit. Teaches bursting a caller before it brings its pack in: kill her before the Signal and the Nettles never come out."
max_hp = 48
intents = Array[ExtResource("2_intent")]([SubResource("EnemyIntent_pinch"), SubResource("EnemyIntent_signal"), SubResource("EnemyIntent_sting")])
contact_sounds = Array[AudioStream]([ExtResource("3_hit_shell"), ExtResource("4_hit_shell_2"), ExtResource("5_hit_shell_3")])
model_scene_path = "res://assets/models/enemies/Nettlebasket/Nettlebasket.glb"
attachment_scene_path = "res://field/nettlebasket_pose.tscn"
battle_camera_turn_degrees = 40.0
painted_albedo_path = "res://assets/models/enemies/Nettlebasket/Nettlebasket_0.jpg"
contact_radius_m = 1.4
